# API Configuration
IA_API_KEY=mock-key-para-desenvolvimento-local

# Instagram Validation (Opcional - requer chave da API do Instagram/Facebook)
# INSTAGRAM_API_KEY=sua-chave-instagram-graph-api
# ENABLE_REAL_INSTAGRAM_VALIDATION=false

# Para produção, use uma chave real da OpenAI:
# IA_API_KEY=sk-proj-sua-chave-aqui

# Outros modelos disponíveis:
# M2: geração real (o modo demo usa imagens ilustrativas)
# OPENAI_API_KEY=sk-...
# ALLOW_MOCK_GENERATION=false
# IA_TEXT_MODEL=gpt-4o-mini
IA_IMAGE_MODEL=gpt-image-2
IA_IMAGE_QUALITY=medium
# S3_BUCKET=pengyn-assets
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# ASSET_PUBLIC_BASE_URL=https://assets.example.com
